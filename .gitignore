# 含百炼 API Key，切勿提交到远程仓库
run_v32.ps1
run_capture_agent.ps1
# Agent 运行缓存（归一化 IQ，体积大，可随时删除重生成）
benchmark_v3/dataset_d*/_agent_cache/
# 训练模型权重（二进制，非代码，可重训）
benchmark_v3/adapters/rad_cls/rad_classifier/
# 旧数据集备份 / 重生成中间产物（大体积，仅本地留存，非代码）
benchmark_v3/_old_dataset_*/
benchmark_v3/_regen_d34/
benchmark_v3/_probe_d*/
# 旧 agent 缓存备份（清缓存重建时留档）
benchmark_v3/dataset_d*/_agent_cache_pre_*/
# 数据集主体不入库（GB 级 IQ/缓存），但基线数字必须入库——它是“防前态过期”核心机制
benchmark_v3/dataset_d*/*
!benchmark_v3/dataset_d*/BASELINE.json
# 私人笔记，勿提交/上传
/README.private.md
_dryrun.log
.workbuddy/
__pycache__/
*.pyc
